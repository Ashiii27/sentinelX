# ── Server ─────────────────────────────────────────────────────────────
# Port for the REST API + WebSocket server
PORT=4000

# Comma-separated list of allowed CORS origins, or * for any
CORS_ORIGIN=*

# ── Database ───────────────────────────────────────────────────────────
# MongoDB connection string. If Mongo is unreachable the backend starts
# in in-memory mode (alerts are kept in a bounded ring buffer, not
# persisted across restarts) and logs a warning.
MONGO_URI=mongodb://127.0.0.1:27017/sentinelx

# ── Engine bridge ──────────────────────────────────────────────────────
# Unix socket the C++ engine connects to (must match the engine's
# --socket argument / AlertEmitter default).
ENGINE_SOCKET=/run/sentinelx/alerts.sock

# ── YARA rule management ───────────────────────────────────────────────
# Directory the engine loads rules from (and where the rules API
# creates/edits rule files). Defaults to <repo>/engine/rules.
#RULES_DIR=../../engine/rules

# PID file written by the engine (deployment/sentinelx.service creates
# it). Used by POST /api/rules/reload to send SIGUSR1 for hot reload.
#ENGINE_PID_FILE=/run/sentinelx/sentinelx.pid

# ── Geo-IP (optional) ──────────────────────────────────────────────────
# Path to a MaxMind GeoLite2-City .mmdb database. When set and readable,
# every alert is enriched with geo {country, city, lat, lon, asn} for
# the dashboard Threat Map. Leave empty to disable (default) — alerts
# flow through untouched.
#
# Download: https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
# (free account required)
#GEOIP_MMDB=
